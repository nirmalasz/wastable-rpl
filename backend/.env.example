# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# ---- Data (matches docker-compose.yml) ----
DATABASE_URL=postgres://wastable:wastable@localhost:5432/wastable
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PASSWORD_RESET_TTL_MINUTES=10

# ---- Agentic AI (Gemini) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_DAILY_REQUEST_LIMIT=20

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="WASTABLE <no-reply@wastable.app>"

# ---- File storage (Cloudflare R2) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wastable-images
