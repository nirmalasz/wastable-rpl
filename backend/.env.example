# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
# Number of reverse proxies / load balancers in front of the API (0 when running it directly)
TRUST_PROXY=0

# ---- Data (matches docker-compose.yml) ----
DATABASE_URL=postgres://wastable:wastable@localhost:5432/wastable
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PASSWORD_RESET_TTL_MINUTES=10

# ---- Agentic AI ----
# "gemini" or "groq". Both have free tiers (Google AI Studio / console.groq.com).
# With no key for the chosen provider, the app falls back to rule-based moderation and drafts.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# openai/gpt-oss-20b is the smallest Groq model that passed our listing + moderation prompts
# (allam-2-7b got time zones wrong and let spoiled food through). Groq models here are text-only,
# so photo-only drafts fall back to the heuristic unless GROQ_VISION=true with a vision model.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION=false
AI_DAILY_REQUEST_LIMIT=20

# ---- Email ----
# "off" until SMTP is set up: new accounts are active right away, no verification email.
EMAIL_VERIFICATION=off
# Not used yet: sendMail only logs messages. Fill these in when nodemailer is wired up.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="WASTABLE <no-reply@wastable.app>"

# ---- File storage (Cloudflare R2) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wastable-images

# Public base URL of this API (used in photo links) and where uploads are stored
PUBLIC_URL=http://localhost:4000
UPLOAD_DIR=uploads
