# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
# Number of reverse proxies / load balancers in front of the API (0 when running it directly)
TRUST_PROXY=0

# ---- Data (matches docker-compose.yml) ----
# Neon: use the *direct* (non-pooled) connection string, ending in ?sslmode=require
DATABASE_URL=postgres://wastable:wastable@localhost:5432/wastable
# Optional. Leave empty to run without Redis (AI cache/quota kept in memory).
# Heroku Key-Value Store / Upstash rediss:// URLs work as-is.
REDIS_URL=redis://localhost:6379
# Apply pending migrations on startup (safe with several dynos: guarded by a lock)
MIGRATE_ON_START=true

# ---- Auth ----
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PASSWORD_RESET_TTL_MINUTES=10

# ---- Agentic AI ----
# "gemini" or "groq". Both have free tiers (Google AI Studio / console.groq.com).
# With no key for the chosen provider, the app falls back to rule-based moderation and drafts.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# openai/gpt-oss-20b is the smallest Groq model that passed our listing + moderation prompts
# (allam-2-7b got time zones wrong and let spoiled food through). Groq models here are text-only,
# so photo-only drafts fall back to the heuristic unless GROQ_VISION=true with a vision model.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION=false
AI_DAILY_REQUEST_LIMIT=20

# ---- Email ----
# "off": new accounts are active right away, no verification email. Turn "on" once SMTP works.
EMAIL_VERIFICATION=off
# Any SMTP provider (Brevo, Mailgun, SendGrid, Gmail app password, ...). Without SMTP_HOST
# emails are only logged, so password reset does not work in production.
# Links in emails point to the first CORS_ORIGIN.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="WASTABLE <no-reply@wastable.app>"

# ---- Pin -> address lookup ----
# "nominatim" (OpenStreetMap, free) or "off"
GEOCODER=nominatim
GEOCODER_USER_AGENT="WASTABLE/0.1 (student project; https://github.com/nirmalasz/wastable-rpl)"

# ---- Photo storage ----
# S3-compatible bucket, required on Heroku (its disk is wiped on every restart).
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto,
# S3_PUBLIC_URL = the bucket's public r2.dev URL or custom domain.
# Leave S3_BUCKET empty to store photos on local disk in UPLOAD_DIR (development).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Public base URL of this API (used in local-disk photo links) and where those are stored
PUBLIC_URL=http://localhost:4000
UPLOAD_DIR=uploads
